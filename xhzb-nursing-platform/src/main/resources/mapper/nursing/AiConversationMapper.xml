<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.AiConversationMapper">

    <resultMap type="com.xhzb.nursing.domain.AiConversation" id="AiConversationResult">
        <result property="id"         column="id"          />
        <result property="name"       column="name"        />
        <result property="createBy"   column="create_by"   />
        <result property="updateBy"   column="update_by"   />
        <result property="createTime" column="create_time"  />
        <result property="updateTime" column="update_time"  />
    </resultMap>

    <sql id="selectConversationVo">
        select id, name, create_by, update_by, create_time, update_time from ai_conversation
    </sql>

    <select id="selectConversationListByUserId" parameterType="Long" resultMap="AiConversationResult">
        <include refid="selectConversationVo"/>
        where create_by = #{createBy}
        order by create_time desc
    </select>

</mapper>
